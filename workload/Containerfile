FROM cgr.dev/chainguard/python@sha256:3e56a2973d429d5bf28d8dd99f929ea6344b0bf054c432f09cf579f747ee3114
ARG SOURCE_REVISION=unknown
LABEL org.opencontainers.image.source="https://github.com/jkershawrh/virtualization-ai-foundations" \
      org.opencontainers.image.revision="$SOURCE_REVISION" \
      org.opencontainers.image.title="Virtualization + AI 101 adapter"

WORKDIR /app
COPY --chown=65532:65532 workload /app/workload
COPY --chown=65532:65532 contracts/examples /app/contracts/examples

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    ADAPTER_HOST=0.0.0.0 \
    ADAPTER_PORT=8080 \
    ADAPTER_MODE=rehearsal

USER 65532:65532
EXPOSE 8080
CMD ["-m", "workload.app"]
